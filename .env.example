DATABASE_URL=postgresql://ccc_analytics_app:replace-me@127.0.0.1:5432/ccc_analytics
ANALYTICS_HMAC_SECRET=generate-at-least-32-random-bytes
ADMIN_PASSWORD_HASH=generate-with-argon2-before-deploying
ADMIN_SESSION_SECRET=generate-an-independent-32-byte-secret
SITE_URL=https://capitalcareerclub.com
# Local lookup only: the address is discarded after country/subdivision resolve.
GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb
ANALYTICS_ENABLED=true
# Application form -> CRM. Same box, so localhost; the token is the CRM's INTAKE_TOKEN.
CRM_INTAKE_URL=http://127.0.0.1:3002/api/intake
CRM_INTAKE_TOKEN=same-value-as-the-crm-INTAKE_TOKEN
